# Neon Postgres (Vercel Marketplace)
DATABASE_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Single-administrator Engine login
ADMIN_LOGIN_ID=
# Generate with: npm run engine:hash-password
ADMIN_PASSWORD_SCRYPT=
# E.164, for example +917400000000. Never expose this in client code.
ADMIN_PHONE_E164=

# Twilio Verify with a configured WhatsApp sender
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

