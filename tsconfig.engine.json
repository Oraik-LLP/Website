{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "scripts/**/*.ts",
    "drizzle.config.ts",
    "src/data/blog.ts",
    "src/data/products.ts",
    "src/data/siteContent.ts",
    "src/engine/types.ts"
  ]
}
